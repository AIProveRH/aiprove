# Grader signer key — the EIP-712 signer whose address is set as BountyBoard.graderSigner.
# NEVER commit the real key. Copy to .env and fill in, or export in your shell/secret manager.
# The value below is the well-known anvil account[9] key — LOCAL THROWAWAY ONLY, never fund it.
GRADER_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# Optional: RPC for the proof (defaults to the local ephemeral anvil).
# RPC_URL=http://127.0.0.1:8545
